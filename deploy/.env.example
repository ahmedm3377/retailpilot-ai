# Settings for deploy/compose.yaml. Copy to deploy/.env (git-ignored) and change what you need;
# every line is optional. This is Compose's file, separate from the app's own .env at the repository root.

# Shared by the MCP server and the API. It never leaves the containers' private network namespace,
# but change it anyway: whoever holds it can read any customer's data through the tools.
MCP_AUTH_TOKEN=change-this-local-token

# PostgreSQL password, applied when the data volume is FIRST created (changing it later needs a new volume).
POSTGRES_PASSWORD=retail

# The Ollama model, pulled on the first start. Declare what results.json reports about it.
OLLAMA_MODEL=gemma4:e2b
LLM_QUANTIZATION=Q4_K_M
# LLM_MODEL_REVISION=<digest from: docker compose -f deploy/compose.yaml exec ollama ollama list>

# Where the published ports listen. Keep 127.0.0.1 unless you need other machines to reach the UI:
# sign-in has no password, so 0.0.0.0 exposes every customer's orders to your network.
BIND_ADDRESS=127.0.0.1
UI_PORT=5173
POSTGRES_PORT=55432
GRAFANA_PORT=13000
TEMPO_PORT=13200
PROMETHEUS_PORT=19090
