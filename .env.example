# ---- The model: any local engine LiteLLM can reach. Change these lines to switch model or engine. ----
# LLM_MODEL is a LiteLLM route. LLM_API_BASE must be loopback, or a host you list in LLM_ALLOWED_HOSTS.

# Ollama Model
LLM_MODEL=ollama_chat/gemma4:e2b
LLM_API_BASE=http://127.0.0.1:11434

# VLLM Model
#LLM_MODEL=gemma4-retail
#LLM_API_BASE=https://cnsc5qrg09enl8-8888.proxy.runpod.net/v1/

# LLM_API_KEY=                    # only if your server requires one
# LLM_ALLOWED_HOSTS=my-gpu-box    # your own servers beyond loopback (hosted LLM APIs break the brief)
# Engine-specific parameters, passed through as JSON. Gemma 4 thinks by default, costing ~18 s per reply.
LLM_EXTRA_PARAMS={"think": false}
#
# Example, vLLM (started with --enable-auto-tool-choice not needed; agents use JSON schema output):
#   LLM_MODEL=hosted_vllm/google/gemma-3-4b-it
#   LLM_API_BASE=http://127.0.0.1:8000/v1
#   LLM_EXTRA_PARAMS={}
#   LLM_ENGINE=vllm
#   LLM_SERVER_PROCESSES=vllm,python
#
# What results.json declares about the model. No neutral API reports these, so keep them accurate.
LLM_ENGINE=ollama
LLM_ENGINE_VERSION=0.40.12
LLM_MODEL_REVISION=b37049369adfe3d2b653af0ab301a062ca5cbe96ace6aa0d3f2559ee9b563fc2
LLM_QUANTIZATION=Q4_K_M
# For benchmarks: model server process names (for RAM), and how to evict the model for --cold-start.
LLM_SERVER_PROCESSES=ollama,llama-server
LLM_UNLOAD_COMMAND=ollama stop gemma4:e2b
LLM_TIMEOUT_SECONDS=75
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0
LLM_TOP_P=1
LLM_SEED=7

# Local PostgreSQL from docker-compose.yml (development credentials only).
DATABASE_URL=postgresql://retail:retail@127.0.0.1:55432/retail
# Tests refuse any database whose name does not end in _test.
RETAIL_TEST_DATABASE_URL=postgresql://retail:retail@127.0.0.1:55432/retail_test

# Step 3: local model (LiteLLM -> Ollama), agents, guardrails
AGENT_MAX_TOOL_STEPS=5
CHECKPOINT_SCHEMA=retail_checkpoints
GUARDRAILS_ENABLED=true
GUARDRAILS_JAILBREAK_THRESHOLD=0.8
GUARDRAILS_TOXICITY_THRESHOLD=0.5
GUARDRAILS_FAIL_CLOSED=true
GUARDRAILS_MAX_INPUT_CHARS=2000
# Offline/telemetry (also set as defaults in code by apply_offline_defaults)
LITELLM_LOCAL_MODEL_COST_MAP=True
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
OTEL_SDK_DISABLED=true
LANGSMITH_TRACING=false

# Step 5: API + UI (server-side only; nothing here is exposed to the browser)
# API binds 127.0.0.1:8080 (uv run python -m app.api.serve); Vite dev server 127.0.0.1:5173 proxies /api and /health.
# Demo sessions live in DATABASE_URL (retail) as retail_ui_* schemas plus the retail_ui_registry schema.

# Step 6 accepted optimizations (both default on; set 0 to reproduce the baseline behaviour)
RETAIL_DB_POOL=1
RETAIL_CONFIRM_TEMPLATE=1

# The standalone MCP server; both it and the app read these.
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_SERVER_PORT=8765
MCP_AUTH_TOKEN=vPdK-Mzy3kPoGUdPUvWFIKS1QngklN5YnexDMXqSjnc
